+void abAppend(struct abuf *ab, const char *s, int len) {
+    while (len > 0) {
+        int space = (int)sizeof(ab->bytes)-ab->len;
+        int chunk = len < space ? len : space;
+        memcpy(ab->bytes+ab->len,s,chunk);
+        ab->len += chunk;
+        s += chunk;
+        len -= chunk;
+        if (ab->len == (int)sizeof(ab->bytes)) abFlush(ab);
+    }
 }
 
